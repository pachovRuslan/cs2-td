@@ -0,0 +1,69 @@
+"use client";
+
+import { useAppSelector } from "@/store/hooks";
+import { TOTAL_WAVES } from "@/lib/game/data/waves";
+import { formatMoney, formatNumber } from "@/lib/ui/format";
+
+/** Деньги, HP базы, раунд, счёт. */
+export default function HUD() {
+  const { money, baseHp, baseHpMax, score, kills, waveState } = useAppSelector(
+    (s) => s.game
+  );
+
+  const hpRatio = baseHpMax > 0 ? baseHp / baseHpMax : 0;
+  const hpColor =
+    hpRatio > 0.5 ? "bg-emerald-500" : hpRatio > 0.25 ? "bg-amber-400" : "bg-red-500";
+
+  const shownWave = waveState.phase === "countdown" ? waveState.nextWave : waveState.wave;
+  const waveLabel = waveState.isEndless || shownWave > TOTAL_WAVES
+    ? `${shownWave} · endless`
+    : `${shownWave} / ${TOTAL_WAVES}`;
+
+  return (
+    <section className="space-y-3">
+      <div className="flex items-end justify-between">
+        <div>
+          <div className="text-[11px] uppercase tracking-widest text-zinc-500">Деньги</div>
+          <div className="font-mono text-3xl font-bold text-lime-400 tabular-nums">
+            {formatMoney(money)}
+          </div>
+        </div>
+        <div className="text-right">
+          <div className="text-[11px] uppercase tracking-widest text-zinc-500">Раунд</div>
+          <div className="font-mono text-xl font-bold text-zinc-100 tabular-nums">
+            {waveLabel}
+          </div>
+        </div>
+      </div>
+
+      <div>
+        <div className="mb-1 flex justify-between text-xs">
+          <span className="font-medium text-sky-300">CT-база</span>
+          <span className="font-mono tabular-nums text-zinc-300">
+            {baseHp} / {baseHpMax}
+          </span>
+        </div>
+        <div className="h-2.5 overflow-hidden rounded-full bg-zinc-800">
+          <div
+            className={`h-full ${hpColor} transition-[width] duration-300`}
+            style={{ width: `${hpRatio * 100}%` }}
+          />
+        </div>
+      </div>
+
+      <div className="grid grid-cols-2 gap-2 text-xs">
+        <Stat label="Счёт" value={formatNumber(score)} />
+        <Stat label="Киллы" value={formatNumber(kills)} />
+      </div>
+    </section>
+  );
+}
+
+function Stat({ label, value }: { label: string; value: string }) {
+  return (
+    <div className="rounded-md bg-zinc-800/60 px-2.5 py-1.5">
+      <div className="text-zinc-500">{label}</div>
+      <div className="font-mono text-sm font-semibold tabular-nums text-zinc-100">{value}</div>
+    </div>
+  );
+}
diff --git a/src/components/game/TowerTooltip.tsx b/src/components/game/TowerTooltip.tsx
index e69de29..3b41cc1 100644
--- a/src/components/game/TowerTooltip.tsx
+++ b/src/components/game/TowerTooltip.tsx
@@ -0,0 +1,101 @@
+"use client";
+
+import { gameEvents, GameEvents } from "@/lib/game/events";
+import { TOWERS } from "@/lib/game/data/towers";
+import type { TowerKind } from "@/lib/game/types";
+import { useAppSelector } from "@/store/hooks";
+import { formatNumber, hexColor } from "@/lib/ui/format";
+import { Kbd } from "./Controls";
+
+/** Панель выбранной построенной башни: характеристики, апгрейд, продажа. */
+export default function TowerTooltip() {
+  const info = useAppSelector((s) => s.ui.selectedTower);
+  const money = useAppSelector((s) => s.game.money);
+
+  if (!info) return null;
+
+  const cfg = TOWERS[info.type as TowerKind];
+  const cur = cfg.levels[info.level - 1];
+  const next = info.level < 3 ? cfg.levels[info.level] : null;
+  const canUpgrade = info.upgradeCost !== null && money >= info.upgradeCost;
+
+  return (
+    <section className="rounded-lg border border-amber-400/40 bg-zinc-800/70 p-3">
+      <div className="mb-2 flex items-center gap-2">
+        <span
+          className="flex h-9 w-9 items-center justify-center rounded-full border-2 border-black/60 font-mono text-[10px] font-bold text-white"
+          style={{ backgroundColor: hexColor(cfg.color) }}
+        >
+          {cfg.icon}
+        </span>
+        <div className="min-w-0 flex-1">
+          <div className="text-sm font-bold text-zinc-100">{cfg.name}</div>
+          <div className="flex gap-1" aria-label={`Уровень ${info.level} из 3`}>
+            {[1, 2, 3].map((l) => (
+              <span
+                key={l}
+                className={`h-1.5 w-5 rounded-full ${l <= info.level ? "bg-amber-400" : "bg-zinc-600"}`}
+              />
+            ))}
+          </div>
+        </div>
+        <button
+          type="button"
+          aria-label="Закрыть"
+          onClick={() => gameEvents.emit(GameEvents.TOWER_DESELECTED)}
+          className="rounded px-1.5 text-lg leading-none text-zinc-500 hover:text-zinc-200"
+        >
+          ×
+        </button>
+      </div>
+
+      <dl className="mb-3 grid grid-cols-3 gap-1.5 text-center text-xs">
+        {cur.damage > 0 && <StatDelta label="Урон" cur={cur.damage} next={next?.damage} />}
+        <StatDelta label="Радиус" cur={cur.range} next={next?.range} />
+        <StatDelta label="Выстр/с" cur={cur.fireRate} next={next?.fireRate} />
+      </dl>
+
+      <div className="mb-3 flex justify-between text-xs text-zinc-400">
+        <span>
+          Киллы: <b className="font-mono text-zinc-200">{formatNumber(info.kills)}</b>
+        </span>
+        <span>
+          Урон всего: <b className="font-mono text-zinc-200">{formatNumber(info.damageDealt)}</b>
+        </span>
+      </div>
+
+      <div className="grid grid-cols-2 gap-2">
+        <button
+          type="button"
+          disabled={!canUpgrade}
+          onClick={() => gameEvents.emit(GameEvents.UPGRADE_TOWER)}
+          className="rounded-md bg-lime-500 px-2 py-2 text-xs font-bold text-zinc-950 transition hover:bg-lime-400 disabled:cursor-not-allowed disabled:bg-zinc-700 disabled:text-zinc-400"
+        >
+          {info.upgradeCost === null ? "Макс. уровень" : `Апгрейд $${info.upgradeCost}`}
+          <Kbd>U</Kbd>
+        </button>
+        <button
+          type="button"
+          onClick={() => gameEvents.emit(GameEvents.SELL_TOWER)}
+          className="rounded-md bg-zinc-700 px-2 py-2 text-xs font-bold text-zinc-100 transition hover:bg-red-600"
+        >
+          Продать ${info.sellValue}
+          <Kbd>S</Kbd>
+        </button>
+      </div>
+    </section>
+  );
+}
+
+function StatDelta({ label, cur, next }: { label: string; cur: number; next?: number }) {
+  const diff = next !== undefined ? +(next - cur).toFixed(2) : 0;
+  return (
+    <div className="rounded bg-zinc-900/60 px-1 py-1.5">
+      <dt className="text-zinc-500">{label}</dt>
+      <dd className="font-mono font-semibold text-zinc-100">
+        {cur}
+        {diff > 0 && <span className="ml-1 text-lime-400">+{diff}</span>}
+      </dd>
+    </div>
+  );
+}
diff --git a/src/components/game/useGameBridge.ts b/src/components/game/useGameBridge.ts
new file mode 100644
index 0000000..6a56926
--- /dev/null
+++ b/src/components/game/useGameBridge.ts
@@ -0,0 +1,61 @@
+"use client";
+
+import { useEffect } from "react";
+import {
+  gameEvents,
+  GameEvents,
+  type SceneName,
+  type TowerInfoPayload,
+  type WaveStatePayload,
+} from "@/lib/game/events";
+import type { GameSpeed, TowerKind } from "@/lib/game/types";
+import { useAppDispatch } from "@/store/hooks";
+import {
+  setBaseHp,
+  setKills,
+  setMoney,
+  setScore,
+  setWaveState,
+} from "@/store/slices/gameSlice";
+import {
+  selectTower,
+  setCurrentScene,
+  setGameSpeed,
+  setPaused,
+  setSelectedTower,
+} from "@/store/slices/uiSlice";
+
+/**
+ * Мост Phaser → Redux: слушает gameEvents и складывает значения в стор.
+ * Команды в обратную сторону (React → Phaser) компоненты шлют напрямую через gameEvents.
+ *
+ * Подписка ставится до создания Phaser.Game, поэтому первые события не теряются.
+ */
+export function useGameBridge(): void {
+  const dispatch = useAppDispatch();
+
+  useEffect(() => {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const handlers: [string, (payload: any) => void][] = [
+      [GameEvents.MONEY_CHANGED, ({ money }: { money: number }) => dispatch(setMoney(money))],
+      [GameEvents.BASE_HP_CHANGED, ({ hp }: { hp: number }) => dispatch(setBaseHp(hp))],
+      [GameEvents.SCORE_CHANGED, ({ score }: { score: number }) => dispatch(setScore(score))],
+      [GameEvents.KILLS_CHANGED, ({ kills }: { kills: number }) => dispatch(setKills(kills))],
+      [GameEvents.WAVE_STATE, (w: WaveStatePayload) => dispatch(setWaveState(w))],
+      [GameEvents.SCENE_CHANGED, ({ scene }: { scene: SceneName }) => dispatch(setCurrentScene(scene))],
+      [GameEvents.PAUSE_TOGGLED, ({ paused }: { paused: boolean }) => dispatch(setPaused(paused))],
+      [GameEvents.SPEED_CHANGED, ({ speed }: { speed: GameSpeed }) => dispatch(setGameSpeed(speed))],
+      [
+        GameEvents.TOWER_SELECTED,
+        ({ towerType }: { towerType: string | null }) =>
+          dispatch(selectTower(towerType as TowerKind | null)),
+      ],
+      [GameEvents.TOWER_INFO, (info: TowerInfoPayload | null) => dispatch(setSelectedTower(info))],
+    ];
+
+    for (const [event, fn] of handlers) gameEvents.on(event, fn);
+    return () => {
+      for (const [event, fn] of handlers) gameEvents.off(event, fn);
+    };
+  }, [dispatch]);
+}
