diff --git a/src/lib/game/systems/ParticleSystem.ts b/src/lib/game/systems/ParticleSystem.ts
index e69de29..60c8bcb 100644
--- a/src/lib/game/systems/ParticleSystem.ts
+++ b/src/lib/game/systems/ParticleSystem.ts
@@ -0,0 +1,95 @@
+import Phaser from "phaser";
+
+/**
+ * Простые визуальные эффекты на примитивах (без текстур).
+ * Твины идут через scene.tweens, поэтому подчиняются паузе и скорости сцены.
+ */
+export class ParticleSystem {
+  constructor(private scene: Phaser.Scene) {}
+
+  /** Взрыв HE/C4: расширяющееся кольцо + вспышка. */
+  explosion(x: number, y: number, radius: number, color = 0xffa040): void {
+    const flash = this.scene.add.circle(x, y, radius * 0.4, 0xffffff, 0.9).setDepth(30);
+    const ring = this.scene.add
+      .circle(x, y, radius * 0.3, color, 0.45)
+      .setStrokeStyle(3, color, 0.9)
+      .setDepth(29);
+
+    this.scene.tweens.add({
+      targets: flash,
+      alpha: 0,
+      scale: 1.6,
+      duration: 160,
+      onComplete: () => flash.destroy(),
+    });
+    this.scene.tweens.add({
+      targets: ring,
+      scale: radius / (radius * 0.3),
+      alpha: 0,
+      duration: 380,
+      ease: "Cubic.easeOut",
+      onComplete: () => ring.destroy(),
+    });
+  }
+
+  /** Облако смока на время действия замедления. */
+  smokeCloud(x: number, y: number, radius: number, durationMs: number): void {
+    const cloud = this.scene.add.circle(x, y, radius * 0.5, 0xbfbfbf, 0).setDepth(25);
+    this.scene.tweens.chain({
+      targets: cloud,
+      tweens: [
+        { scale: 2, alpha: 0.45, duration: 250, ease: "Quad.easeOut" },
+        { alpha: 0.35, duration: Math.max(0, durationMs - 650) },
+        { alpha: 0, duration: 400 },
+      ],
+      onComplete: () => cloud.destroy(),
+    });
+  }
+
+  /** Попадание пули: маленькая искра. */
+  hit(x: number, y: number, color = 0xffe08a): void {
+    const spark = this.scene.add.circle(x, y, 3, color, 1).setDepth(28);
+    this.scene.tweens.add({
+      targets: spark,
+      scale: 2.2,
+      alpha: 0,
+      duration: 140,
+      onComplete: () => spark.destroy(),
+    });
+  }
+
+  /** Вспышка выстрела у ствола. */
+  muzzle(x: number, y: number): void {
+    const f = this.scene.add.circle(x, y, 4, 0xfff2a0, 0.95).setDepth(21);
+    this.scene.tweens.add({
+      targets: f,
+      alpha: 0,
+      scale: 0.4,
+      duration: 70,
+      onComplete: () => f.destroy(),
+    });
+  }
+
+  /** Всплывающий текст (+$, урон и т.п.). */
+  floatingText(x: number, y: number, text: string, color = "#ffd34a"): void {
+    const t = this.scene.add
+      .text(x, y, text, {
+        fontFamily: "monospace",
+        fontSize: "11px",
+        color,
+        fontStyle: "bold",
+        stroke: "#000000",
+        strokeThickness: 3,
+      })
+      .setOrigin(0.5)
+      .setDepth(40);
+    this.scene.tweens.add({
+      targets: t,
+      y: y - 22,
+      alpha: 0,
+      duration: 700,
+      ease: "Quad.easeOut",
+      onComplete: () => t.destroy(),
+    });
+  }
+}
diff --git a/src/lib/game/systems/PlacementSystem.ts b/src/lib/game/systems/PlacementSystem.ts
index e69de29..a24fd5a 100644
--- a/src/lib/game/systems/PlacementSystem.ts
+++ b/src/lib/game/systems/PlacementSystem.ts
@@ -0,0 +1,84 @@
+import { NO_BUILD_ZONES } from "../data/map";
+import { ALL_PATHS, PATHS } from "../data/paths";
+import { GAME_WIDTH, GAME_HEIGHT } from "../config";
+import { closestPointOnSegment, distanceSquared } from "../utils/math";
+import type { TowerRuntime } from "../types";
+
+export const TOWER_RADIUS = 13;
+/** Минимальная дистанция от центра башни до оси пути. */
+const PATH_CLEARANCE = 24;
+/** Минимальная дистанция между центрами башен. */
+const TOWER_SPACING = TOWER_RADIUS * 2 + 2;
+const EDGE_MARGIN = 30;
+
+export type PlacementError =
+  | "out_of_bounds"
+  | "blocked"
+  | "on_path"
+  | "occupied"
+  | "no_money";
+
+export const PLACEMENT_ERROR_TEXT: Record<PlacementError, string> = {
+  out_of_bounds: "За пределами карты",
+  blocked: "Здесь нельзя строить",
+  on_path: "Нельзя строить на пути",
+  occupied: "Слишком близко к другой башне",
+  no_money: "Недостаточно денег",
+};
+
+/**
+ * Проверка, можно ли поставить башню в точку.
+ * Чистая геометрия — без Phaser, легко тестировать.
+ */
+export class PlacementSystem {
+  check(
+    x: number,
+    y: number,
+    towers: readonly TowerRuntime[],
+    canAfford: boolean
+  ): PlacementError | null {
+    if (
+      x < EDGE_MARGIN ||
+      y < EDGE_MARGIN ||
+      x > GAME_WIDTH - EDGE_MARGIN ||
+      y > GAME_HEIGHT - EDGE_MARGIN
+    ) {
+      return "out_of_bounds";
+    }
+
+    for (const z of NO_BUILD_ZONES) {
+      if (
+        x + TOWER_RADIUS > z.x &&
+        x - TOWER_RADIUS < z.x + z.w &&
+        y + TOWER_RADIUS > z.y &&
+        y - TOWER_RADIUS < z.y + z.h
+      ) {
+        return "blocked";
+      }
+    }
+
+    if (this.isNearPath(x, y)) return "on_path";
+
+    const minSq = TOWER_SPACING * TOWER_SPACING;
+    for (const t of towers) {
+      if (distanceSquared(x, y, t.x, t.y) < minSq) return "occupied";
+    }
+
+    if (!canAfford) return "no_money";
+    return null;
+  }
+
+  private isNearPath(x: number, y: number): boolean {
+    const clearSq = PATH_CLEARANCE * PATH_CLEARANCE;
+    for (const id of ALL_PATHS) {
+      const path = PATHS[id];
+      for (let i = 1; i < path.length; i++) {
+        const a = path[i - 1];
+        const b = path[i];
+        const p = closestPointOnSegment(x, y, a.x, a.y, b.x, b.y);
+        if (distanceSquared(x, y, p.x, p.y) < clearSq) return true;
+      }
+    }
+    return false;
+  }
+}
diff --git a/src/lib/game/systems/ProjectileSystem.ts b/src/lib/game/systems/ProjectileSystem.ts
index e69de29..b54c219 100644
--- a/src/lib/game/systems/ProjectileSystem.ts
+++ b/src/lib/game/systems/ProjectileSystem.ts
@@ -0,0 +1,150 @@
+import Phaser from "phaser";
+import type { ProjectileRuntime, TowerConfig } from "../types";
+import { SPRITE_KEYS } from "../data/sprites";
+import type { EnemySystem } from "./EnemySystem";
+import type { ParticleSystem } from "./ParticleSystem";
+
+const HIT_DISTANCE = 6;
+
+export interface FireParams {
+  x: number;
+  y: number;
+  targetId: string;
+  targetX: number;
+  targetY: number;
+  speed: number;
+  damage: number;
+  sprite: string;
+  ownerId: string;
+  effect?: TowerConfig["effect"];
+}
+
+/**
+ * Снаряды: самонаведение на цель, попадание, AoE/slow/stun.
+ * Если цель умерла — снаряд долетает до её последней позиции
+ * (гранаты при этом всё равно взрываются, пули просто исчезают).
+ */
+export class ProjectileSystem {
+  private projectiles: ProjectileRuntime[] = [];
+  private graphics: Phaser.GameObjects.Graphics;
+  private nextId = 1;
+
+  /** Сообщает, сколько урона нанесла башня и убила ли она кого-то. */
+  onDamageDealt?: (ownerId: string, damage: number, kills: number) => void;
+
+  constructor(
+    scene: Phaser.Scene,
+    private enemies: EnemySystem,
+    private particles: ParticleSystem
+  ) {
+    this.graphics = scene.add.graphics().setDepth(20);
+  }
+
+  fire(p: FireParams): void {
+    this.projectiles.push({ id: `p${this.nextId++}`, ...p });
+  }
+
+  /** dt — секунды, now — мс игрового времени. */
+  update(dt: number, now: number): void {
+    const done = new Set<string>();
+
+    for (const p of this.projectiles) {
+      const target = this.enemies.getById(p.targetId);
+      if (target && !target.isDead) {
+        p.targetX = target.x;
+        p.targetY = target.y;
+      }
+
+      const dx = p.targetX - p.x;
+      const dy = p.targetY - p.y;
+      const dist = Math.sqrt(dx * dx + dy * dy);
+      const step = p.speed * dt;
+
+      if (dist <= Math.max(step, HIT_DISTANCE)) {
+        p.x = p.targetX;
+        p.y = p.targetY;
+        this.impact(p, target && !target.isDead ? target.id : null, now);
+        done.add(p.id);
+      } else {
+        p.x += (dx / dist) * step;
+        p.y += (dy / dist) * step;
+      }
+    }
+
+    if (done.size > 0) {
+      this.projectiles = this.projectiles.filter((p) => !done.has(p.id));
+    }
+    this.draw();
+  }
+
+  clear(): void {
+    this.projectiles = [];
+    this.graphics.clear();
+  }
+
+  destroy(): void {
+    this.clear();
+    this.graphics.destroy();
+  }
+
+  private impact(p: ProjectileRuntime, hitId: string | null, now: number): void {
+    const effect = p.effect;
+
+    if (effect?.type === "aoe") {
+      const radius = effect.radius ?? 50;
+      this.particles.explosion(p.x, p.y, radius);
+      let dealt = 0;
+      let kills = 0;
+      for (const e of this.enemies.grid.queryRadius(p.x, p.y, radius)) {
+        const before = e.hp;
+        if (this.enemies.damage(e.id, p.damage)) kills++;
+        dealt += before - e.hp;
+      }
+      this.onDamageDealt?.(p.ownerId, dealt, kills);
+      return;
+    }
+
+    if (effect?.type === "slow") {
+      const radius = effect.radius ?? 60;
+      const duration = effect.duration ?? 2000;
+      this.particles.smokeCloud(p.x, p.y, radius, duration);
+      for (const e of this.enemies.grid.queryRadius(p.x, p.y, radius)) {
+        this.enemies.applySlow(e.id, effect.factor ?? 0.5, now + duration);
+      }
+      return;
+    }
+
+    if (!hitId) return; // пуля, цель уже мертва
+
+    const target = this.enemies.getById(hitId)!;
+    const before = target.hp;
+    const killed = this.enemies.damage(hitId, p.damage);
+    if (effect?.type === "stun" && !killed) {
+      this.enemies.applySlow(hitId, 0, now + (effect.duration ?? 400));
+    }
+    this.particles.hit(p.x, p.y);
+    this.onDamageDealt?.(p.ownerId, before - target.hp, killed ? 1 : 0);
+  }
+
+  private draw(): void {
+    const g = this.graphics;
+    g.clear();
+    for (const p of this.projectiles) {
+      if (p.effect?.type === "aoe" || p.effect?.type === "slow") {
+        // граната / C4
+        g.fillStyle(p.effect.type === "slow" ? 0xcfcfcf : 0x3a4a2a, 1);
+        g.fillCircle(p.x, p.y, 4);
+        g.lineStyle(1, 0x000000, 0.8);
+        g.strokeCircle(p.x, p.y, 4);
+      } else {
+        // пуля — короткий трассер по направлению полёта
+        const dx = p.targetX - p.x;
+        const dy = p.targetY - p.y;
+        const len = Math.sqrt(dx * dx + dy * dy) || 1;
+        const tail = p.sprite === SPRITE_KEYS.PROJECTILE_AWP ? 18 : 7;
+        g.lineStyle(p.sprite === SPRITE_KEYS.PROJECTILE_AWP ? 2 : 1.5, 0xffe08a, 1);
+        g.lineBetween(p.x, p.y, p.x - (dx / len) * tail, p.y - (dy / len) * tail);
+      }
+    }
+  }
+}
diff --git a/src/lib/game/systems/TowerSystem.ts b/src/lib/game/systems/TowerSystem.ts
index e69de29..d9c45c2 100644
--- a/src/lib/game/systems/TowerSystem.ts
+++ b/src/lib/game/systems/TowerSystem.ts
@@ -0,0 +1,211 @@
+import Phaser from "phaser";
+import type { EnemyRuntime, TowerKind, TowerRuntime } from "../types";
+import { TOWERS, getTowerLevel, getTowerSellValue } from "../data/towers";
+import { gameEvents, GameEvents } from "../events";
+import { TOWER_RADIUS } from "./PlacementSystem";
+import type { EnemySystem } from "./EnemySystem";
+import type { ProjectileSystem } from "./ProjectileSystem";
+import type { ParticleSystem } from "./ParticleSystem";
+
+const BARREL_LEN = 16;
+
+interface TowerView {
+  container: Phaser.GameObjects.Container;
+  barrel: Phaser.GameObjects.Rectangle;
+  pips: Phaser.GameObjects.Graphics;
+}
+
+/**
+ * Башни: постройка, апгрейд, продажа, выбор цели и стрельба.
+ * Цель — враг, дальше всех продвинувшийся по пути («first»).
+ */
+export class TowerSystem {
+  private towers: TowerRuntime[] = [];
+  private views = new Map<string, TowerView>();
+  private nextId = 1;
+
+  constructor(
+    private scene: Phaser.Scene,
+    private enemies: EnemySystem,
+    private projectiles: ProjectileSystem,
+    private particles: ParticleSystem
+  ) {}
+
+  getAll(): readonly TowerRuntime[] {
+    return this.towers;
+  }
+
+  getById(id: string): TowerRuntime | undefined {
+    return this.towers.find((t) => t.id === id);
+  }
+
+  /** Башня под точкой (для клика). */
+  getAt(x: number, y: number): TowerRuntime | undefined {
+    const r = TOWER_RADIUS + 2;
+    return this.towers.find((t) => (t.x - x) ** 2 + (t.y - y) ** 2 <= r * r);
+  }
+
+  build(type: TowerKind, x: number, y: number): TowerRuntime {
+    const tower: TowerRuntime = {
+      id: `t${this.nextId++}`,
+      type,
+      x,
+      y,
+      level: 1,
+      lastFireTime: -Infinity,
+      totalKills: 0,
+      totalDamage: 0,
+    };
+    this.towers.push(tower);
+    this.views.set(tower.id, this.createView(tower));
+    gameEvents.emit(GameEvents.TOWER_PLACED, { id: tower.id, type, x, y });
+    return tower;
+  }
+
+  /** Цена апгрейда или null, если уровень максимальный. */
+  getUpgradeCost(tower: TowerRuntime): number | null {
+    const cost = getTowerLevel(tower.type, tower.level).upgradeCost;
+    return tower.level < 3 && cost > 0 ? cost : null;
+  }
+
+  upgrade(id: string): void {
+    const t = this.getById(id);
+    if (!t || t.level >= 3) return;
+    t.level = (t.level + 1) as 2 | 3;
+    this.drawPips(t);
+    this.particles.floatingText(t.x, t.y - 18, `LVL ${t.level}`, "#7fd4ff");
+    gameEvents.emit(GameEvents.TOWER_UPGRADED, { id, level: t.level });
+  }
+
+  /** Удаляет башню, возвращает сумму возврата. */
+  sell(id: string): number {
+    const t = this.getById(id);
+    if (!t) return 0;
+    const refund = getTowerSellValue(t.type, t.level);
+    this.towers = this.towers.filter((x) => x.id !== id);
+    this.views.get(id)?.container.destroy();
+    this.views.delete(id);
+    gameEvents.emit(GameEvents.TOWER_SOLD, { id, refund });
+    return refund;
+  }
+
+  recordDamage(ownerId: string, damage: number, kills: number): void {
+    const t = this.getById(ownerId);
+    if (!t) return;
+    t.totalDamage += damage;
+    t.totalKills += kills;
+  }
+
+  /** now — мс игрового времени. */
+  update(now: number): void {
+    for (const t of this.towers) {
+      const cfg = TOWERS[t.type];
+      const lvl = getTowerLevel(t.type, t.level);
+      const target = this.findTarget(t, lvl.range);
+      if (!target) continue;
+
+      const view = this.views.get(t.id)!;
+      const angle = Math.atan2(target.y - t.y, target.x - t.x);
+      view.barrel.setRotation(angle);
+
+      const cooldown = 1000 / lvl.fireRate;
+      if (now - t.lastFireTime < cooldown) continue;
+      t.lastFireTime = now;
+
+      const mx = t.x + Math.cos(angle) * BARREL_LEN;
+      const my = t.y + Math.sin(angle) * BARREL_LEN;
+      if (cfg.category === "gun" || cfg.category === "agent") {
+        this.particles.muzzle(mx, my);
+      }
+
+      this.projectiles.fire({
+        x: mx,
+        y: my,
+        targetId: target.id,
+        targetX: target.x,
+        targetY: target.y,
+        speed: cfg.projectileSpeed,
+        damage: lvl.damage,
+        sprite: cfg.projectileSprite,
+        ownerId: t.id,
+        effect: cfg.effect,
+      });
+    }
+  }
+
+  clear(): void {
+    for (const v of this.views.values()) v.container.destroy();
+    this.views.clear();
+    this.towers = [];
+  }
+
+  private findTarget(t: TowerRuntime, range: number): EnemyRuntime | null {
+    const inRange = this.enemies.grid.queryRadius(t.x, t.y, range);
+    let best: EnemyRuntime | null = null;
+    let bestScore = -Infinity;
+    for (const e of inRange) {
+      if (e.isDead || e.reachedBase) continue;
+      // smoke предпочитает ещё не замедленных врагов
+      const score =
+        e.pathProgress - (t.type === "smoke" && e.slowFactor < 1 ? 1 : 0);
+      if (score > bestScore) {
+        best = e;
+        bestScore = score;
+      }
+    }
+    return best;
+  }
+
+  private createView(t: TowerRuntime): TowerView {
+    const cfg = TOWERS[t.type];
+
+    const shadow = this.scene.add.circle(2, 3, TOWER_RADIUS, 0x000000, 0.35);
+    const base = this.scene.add
+      .circle(0, 0, TOWER_RADIUS, cfg.color, 1)
+      .setStrokeStyle(2, 0x111111, 1);
+    const barrel = this.scene.add
+      .rectangle(0, 0, BARREL_LEN, 4, 0x1a1a1a, 1)
+      .setOrigin(0, 0.5);
+    const label = this.scene.add
+      .text(0, 0, cfg.icon, {
+        fontFamily: "monospace",
+        fontSize: cfg.icon.length > 2 ? "8px" : "9px",
+        color: "#ffffff",
+        fontStyle: "bold",
+        stroke: "#000000",
+        strokeThickness: 2,
+      })
+      .setOrigin(0.5);
+    const pips = this.scene.add.graphics();
+
+    const container = this.scene.add
+      .container(t.x, t.y, [shadow, base, barrel, label, pips])
+      .setDepth(15);
+
+    const view = { container, barrel, pips };
+    this.views.set(t.id, view);
+    this.drawPips(t);
+
+    container.setScale(0.3);
+    this.scene.tweens.add({
+      targets: container,
+      scale: 1,
+      duration: 180,
+      ease: "Back.easeOut",
+    });
+    return view;
+  }
+
+  /** Точки уровня под башней. */
+  private drawPips(t: TowerRuntime): void {
+    const view = this.views.get(t.id);
+    if (!view) return;
+    const g = view.pips;
+    g.clear();
+    for (let i = 0; i < t.level; i++) {
+      const px = (i - (t.level - 1) / 2) * 6;
+      g.fillStyle(0xffd34a, 1);
+      g.fillCircle(px, TOWER_RADIUS + 4, 2);
+    }
+  }
+}
