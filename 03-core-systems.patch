diff --git a/src/lib/game/systems/EconomySystem.ts b/src/lib/game/systems/EconomySystem.ts
index e69de29..b44f512 100644
--- a/src/lib/game/systems/EconomySystem.ts
+++ b/src/lib/game/systems/EconomySystem.ts
@@ -0,0 +1,74 @@
+import { gameEvents, GameEvents } from "../events";
+
+export const START_MONEY = 800;
+export const BASE_HP_MAX = 100;
+
+/**
+ * Деньги, HP базы, счёт и киллы.
+ * Единственный источник правды для этих значений — React только слушает события.
+ */
+export class EconomySystem {
+  money = START_MONEY;
+  baseHp = BASE_HP_MAX;
+  readonly baseHpMax = BASE_HP_MAX;
+  score = 0;
+  kills = 0;
+
+  /** Вызывается один раз, когда HP базы падает до 0. */
+  onBaseDestroyed?: () => void;
+
+  /** Разослать текущее состояние (при старте сцены). */
+  emitAll(): void {
+    gameEvents.emit(GameEvents.MONEY_CHANGED, { money: this.money });
+    gameEvents.emit(GameEvents.BASE_HP_CHANGED, {
+      hp: this.baseHp,
+      max: this.baseHpMax,
+    });
+    gameEvents.emit(GameEvents.SCORE_CHANGED, { score: this.score });
+  }
+
+  canAfford(cost: number): boolean {
+    return this.money >= cost;
+  }
+
+  /** Списать деньги. Возвращает false, если не хватает. */
+  spend(cost: number): boolean {
+    if (!this.canAfford(cost)) return false;
+    this.money -= cost;
+    gameEvents.emit(GameEvents.MONEY_CHANGED, { money: this.money });
+    return true;
+  }
+
+  earn(amount: number): void {
+    if (amount <= 0) return;
+    this.money += Math.floor(amount);
+    gameEvents.emit(GameEvents.MONEY_CHANGED, { money: this.money });
+  }
+
+  addScore(points: number): void {
+    if (points <= 0) return;
+    this.score += Math.floor(points);
+    gameEvents.emit(GameEvents.SCORE_CHANGED, { score: this.score });
+  }
+
+  registerKill(reward: number, points: number): void {
+    this.kills += 1;
+    this.earn(reward);
+    this.addScore(points);
+  }
+
+  damageBase(amount: number): void {
+    if (this.baseHp <= 0) return;
+    this.baseHp = Math.max(0, this.baseHp - amount);
+    gameEvents.emit(GameEvents.BASE_DAMAGED, { amount });
+    gameEvents.emit(GameEvents.BASE_HP_CHANGED, {
+      hp: this.baseHp,
+      max: this.baseHpMax,
+    });
+    if (this.baseHp === 0) this.onBaseDestroyed?.();
+  }
+
+  get isBaseDestroyed(): boolean {
+    return this.baseHp <= 0;
+  }
+}
diff --git a/src/lib/game/systems/EnemySystem.ts b/src/lib/game/systems/EnemySystem.ts
index e69de29..3c6b0ae 100644
--- a/src/lib/game/systems/EnemySystem.ts
+++ b/src/lib/game/systems/EnemySystem.ts
@@ -0,0 +1,196 @@
+import Phaser from "phaser";
+import type { EnemyKind, EnemyRuntime, PathId, WaveEnemyGroup } from "../types";
+import { ENEMIES } from "../data/enemies";
+import { pathLength, pointAtProgress } from "../data/paths";
+import { SpatialGrid } from "../utils/spatialGrid";
+import { GAME_WIDTH, GAME_HEIGHT } from "../config";
+import { randomRange } from "../utils/math";
+import { gameEvents, GameEvents } from "../events";
+
+const ENEMY_RADIUS = 7;
+const BOSS_RADIUS = 13;
+const HP_BAR_W = 18;
+const BOSS_HP_BAR_W = 32;
+
+/**
+ * Враги: спавн, движение по путям, урон, замедление/оглушение, отрисовка.
+ *
+ * Отрисовка — один Graphics на всех (перерисовывается каждый кадр).
+ * Когда появятся спрайты, здесь можно заменить на Image-пул.
+ */
+export class EnemySystem {
+  private enemies: EnemyRuntime[] = [];
+  private lateralOffset = new Map<string, number>();
+  private pathLengths: Record<PathId, number>;
+  private graphics: Phaser.GameObjects.Graphics;
+  private nextId = 1;
+
+  /** Пространственная сетка живых врагов — для поиска целей башнями. */
+  readonly grid = new SpatialGrid<EnemyRuntime>(GAME_WIDTH, GAME_HEIGHT, 64);
+
+  onKilled?: (enemy: EnemyRuntime) => void;
+  onReachedBase?: (enemy: EnemyRuntime) => void;
+
+  constructor(scene: Phaser.Scene) {
+    this.graphics = scene.add.graphics().setDepth(10);
+    this.pathLengths = {
+      long: pathLength("long"),
+      tunnels: pathLength("tunnels"),
+      mid: pathLength("mid"),
+    };
+  }
+
+  spawn(type: EnemyKind, group: WaveEnemyGroup, pathId: PathId): EnemyRuntime {
+    const cfg = ENEMIES[type];
+    const hp = Math.round(cfg.baseHp * group.hpMul);
+    const speed = cfg.baseSpeed * group.speedMul;
+    const start = pointAtProgress(pathId, 0);
+
+    const enemy: EnemyRuntime = {
+      id: `e${this.nextId++}`,
+      type,
+      pathId,
+      pathProgress: 0,
+      x: start.x,
+      y: start.y,
+      hp,
+      maxHp: hp,
+      speed,
+      baseSpeed: speed,
+      slowUntil: 0,
+      slowFactor: 1,
+      reward: Math.round(cfg.baseReward * group.rewardMul),
+      damage: cfg.baseDamage,
+      isBoss: cfg.isBoss,
+      isDead: false,
+      reachedBase: false,
+    };
+
+    this.enemies.push(enemy);
+    this.lateralOffset.set(enemy.id, cfg.isBoss ? 0 : randomRange(-6, 6));
+    return enemy;
+  }
+
+  /** dt — секунды игрового времени, now — мс игрового времени. */
+  update(dt: number, now: number): void {
+    for (const e of this.enemies) {
+      if (e.isDead || e.reachedBase) continue;
+
+      if (now >= e.slowUntil) e.slowFactor = 1;
+      e.speed = e.baseSpeed * e.slowFactor;
+
+      e.pathProgress += (e.speed * dt) / this.pathLengths[e.pathId];
+
+      if (e.pathProgress >= 1) {
+        e.pathProgress = 1;
+        e.reachedBase = true;
+        gameEvents.emit(GameEvents.ENEMY_REACHED_BASE, { id: e.id });
+        this.onReachedBase?.(e);
+        continue;
+      }
+
+      const p = pointAtProgress(e.pathId, e.pathProgress);
+      const off = this.lateralOffset.get(e.id) ?? 0;
+      // смещение перпендикулярно направлению движения — чтобы толпа не сливалась в точку
+      e.x = p.x - Math.sin(p.angle) * off;
+      e.y = p.y + Math.cos(p.angle) * off;
+    }
+
+    this.removeFinished();
+    this.rebuildGrid();
+    this.draw();
+  }
+
+  /** Нанести урон. Возвращает true, если враг убит этим попаданием. */
+  damage(id: string, amount: number): boolean {
+    const e = this.getById(id);
+    if (!e || e.isDead || e.reachedBase || amount <= 0) return false;
+    e.hp -= amount;
+    if (e.hp <= 0) {
+      e.hp = 0;
+      e.isDead = true;
+      gameEvents.emit(GameEvents.ENEMY_KILLED, { id: e.id, type: e.type });
+      this.onKilled?.(e);
+      return true;
+    }
+    return false;
+  }
+
+  /** factor: 0.5 — замедление на 50%, 0 — оглушение. Берётся сильнейший эффект. */
+  applySlow(id: string, factor: number, until: number): void {
+    const e = this.getById(id);
+    if (!e || e.isDead) return;
+    e.slowFactor = Math.min(e.slowFactor, factor);
+    e.slowUntil = Math.max(e.slowUntil, until);
+  }
+
+  getById(id: string): EnemyRuntime | undefined {
+    return this.enemies.find((e) => e.id === id);
+  }
+
+  getAlive(): readonly EnemyRuntime[] {
+    return this.enemies;
+  }
+
+  get aliveCount(): number {
+    return this.enemies.length;
+  }
+
+  clear(): void {
+    this.enemies = [];
+    this.lateralOffset.clear();
+    this.grid.clear();
+    this.graphics.clear();
+  }
+
+  destroy(): void {
+    this.clear();
+    this.graphics.destroy();
+  }
+
+  private removeFinished(): void {
+    if (!this.enemies.some((e) => e.isDead || e.reachedBase)) return;
+    this.enemies = this.enemies.filter((e) => {
+      const done = e.isDead || e.reachedBase;
+      if (done) this.lateralOffset.delete(e.id);
+      return !done;
+    });
+  }
+
+  private rebuildGrid(): void {
+    this.grid.clear();
+    for (const e of this.enemies) this.grid.insert(e);
+  }
+
+  private draw(): void {
+    const g = this.graphics;
+    g.clear();
+
+    for (const e of this.enemies) {
+      const cfg = ENEMIES[e.type];
+      const r = e.isBoss ? BOSS_RADIUS : ENEMY_RADIUS;
+
+      // тень
+      g.fillStyle(0x000000, 0.35);
+      g.fillCircle(e.x + 2, e.y + 3, r);
+
+      // тело
+      g.fillStyle(cfg.color, 1);
+      g.fillCircle(e.x, e.y, r);
+      g.lineStyle(e.isBoss ? 2 : 1, e.slowFactor < 1 ? 0x9ad0ff : 0x1a0a0a, 1);
+      g.strokeCircle(e.x, e.y, r);
+
+      // HP-бар (только если ранен или босс)
+      if (e.hp < e.maxHp || e.isBoss) {
+        const w = e.isBoss ? BOSS_HP_BAR_W : HP_BAR_W;
+        const ratio = e.hp / e.maxHp;
+        const bx = e.x - w / 2;
+        const by = e.y - r - 6;
+        g.fillStyle(0x000000, 0.7);
+        g.fillRect(bx - 1, by - 1, w + 2, 5);
+        g.fillStyle(ratio > 0.5 ? 0x4ad45a : ratio > 0.25 ? 0xd4c44a : 0xd44a4a, 1);
+        g.fillRect(bx, by, w * ratio, 3);
+      }
+    }
+  }
+}
diff --git a/src/lib/game/systems/WaveSystem.ts b/src/lib/game/systems/WaveSystem.ts
index e69de29..f0a030e 100644
--- a/src/lib/game/systems/WaveSystem.ts
+++ b/src/lib/game/systems/WaveSystem.ts
@@ -0,0 +1,143 @@
+import type { EnemyKind, PathId, WaveConfig, WaveEnemyGroup } from "../types";
+import { getWaveConfig, getWaveReward, TOTAL_WAVES } from "../data/waves";
+import { ALL_PATHS } from "../data/paths";
+import { gameEvents, GameEvents } from "../events";
+import type { EnemySystem } from "./EnemySystem";
+import type { EconomySystem } from "./EconomySystem";
+
+export type WavePhase = "countdown" | "spawning" | "clearing";
+
+interface SpawnEntry {
+  type: EnemyKind;
+  group: WaveEnemyGroup;
+  pathId: PathId;
+}
+
+/**
+ * Управление волнами: отсчёт → спавн → ожидание зачистки → награда → следующая.
+ * Время — в секундах игрового времени (с учётом паузы и скорости).
+ */
+export class WaveSystem {
+  wave = 0;
+  phase: WavePhase = "countdown";
+  /** Секунд до начала следующей волны (в фазе countdown). */
+  countdown = 0;
+
+  private config: WaveConfig | null = null;
+  private queue: SpawnEntry[] = [];
+  private spawnTimer = 0;
+  private pathCursor = 0;
+
+  constructor(
+    private enemies: EnemySystem,
+    private economy: EconomySystem
+  ) {
+    this.prepare(1);
+  }
+
+  get isEndless(): boolean {
+    return this.wave > TOTAL_WAVES;
+  }
+
+  get nextWave(): number {
+    return this.phase === "countdown" ? this.wave + 1 : this.wave;
+  }
+
+  get remainingToSpawn(): number {
+    return this.queue.length;
+  }
+
+  /** Начать следующую волну досрочно (только во время отсчёта). Бонус за раннний вызов. */
+  callEarly(): void {
+    if (this.phase !== "countdown") return;
+    const bonus = Math.floor(this.countdown * 10);
+    if (bonus > 0) this.economy.earn(bonus);
+    this.countdown = 0;
+  }
+
+  update(dt: number): void {
+    switch (this.phase) {
+      case "countdown":
+        this.countdown -= dt;
+        if (this.countdown <= 0) this.startWave();
+        break;
+
+      case "spawning":
+        this.spawnTimer -= dt;
+        while (this.spawnTimer <= 0 && this.queue.length > 0) {
+          const entry = this.queue.shift()!;
+          this.enemies.spawn(entry.type, entry.group, entry.pathId);
+          this.spawnTimer += this.config!.spawnInterval;
+        }
+        if (this.queue.length === 0) this.phase = "clearing";
+        break;
+
+      case "clearing":
+        if (this.enemies.aliveCount === 0) this.completeWave();
+        break;
+    }
+  }
+
+  private prepare(n: number): void {
+    this.config = getWaveConfig(n);
+    this.countdown = this.config.startDelay;
+    this.phase = "countdown";
+  }
+
+  private startWave(): void {
+    const cfg = this.config!;
+    this.wave = cfg.wave;
+    this.queue = this.buildQueue(cfg);
+    this.spawnTimer = 0;
+    this.phase = "spawning";
+    gameEvents.emit(GameEvents.WAVE_STARTED, {
+      wave: this.wave,
+      isEndless: cfg.isEndless,
+    });
+  }
+
+  private completeWave(): void {
+    const reward = getWaveReward(this.wave);
+    this.economy.earn(reward);
+    this.economy.addScore(reward);
+    gameEvents.emit(GameEvents.WAVE_COMPLETED, { wave: this.wave, reward });
+    if (this.wave === TOTAL_WAVES) {
+      gameEvents.emit(GameEvents.WAVE_ALL_DONE, { wave: this.wave });
+    }
+    this.prepare(this.wave + 1);
+  }
+
+  /**
+   * Очередь спавна: группы перемешиваются по кругу (round-robin),
+   * боссы — в конце. Пути чередуются, если у группы нет pathPreference.
+   */
+  private buildQueue(cfg: WaveConfig): SpawnEntry[] {
+    const normal = cfg.groups.filter((g) => !g.enemyType.startsWith("boss"));
+    const bosses = cfg.groups.filter((g) => g.enemyType.startsWith("boss"));
+    const left = normal.map((g) => g.count);
+    const queue: SpawnEntry[] = [];
+
+    let added = true;
+    while (added) {
+      added = false;
+      normal.forEach((g, i) => {
+        if (left[i] > 0) {
+          left[i]--;
+          queue.push(this.entry(g));
+          added = true;
+        }
+      });
+    }
+
+    for (const b of bosses) {
+      for (let i = 0; i < b.count; i++) queue.push(this.entry(b));
+    }
+    return queue;
+  }
+
+  private entry(group: WaveEnemyGroup): SpawnEntry {
+    const pathId =
+      group.pathPreference ?? ALL_PATHS[this.pathCursor++ % ALL_PATHS.length];
+    return { type: group.enemyType, group, pathId };
+  }
+}
